# Notion internal integration token (server-side only, never in the client bundle)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random 32+ byte secret used to HMAC-sign session cookies
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Numeric PIN used to unlock the app
APP_PIN=000000


# Timezone for day/night boundaries (sleep tracking)
TZ=Africa/Casablanca
