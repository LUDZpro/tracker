# Postgres — the app's only store. Read by compose.yml for the "db" service
# and to build the app's DATABASE_URL.
# Generate a password: openssl rand -hex 24
POSTGRES_USER=floor
POSTGRES_DB=floor
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Random 32+ byte secret used to HMAC-sign session cookies
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Numeric PIN used to unlock the app
APP_PIN=000000

# Timezone for day/night boundaries (sleep tracking)
TZ=Africa/Casablanca

# Only needed to re-run the one-time Notion import
# (app/scripts/import-from-notion.mjs); the app itself never reads it.
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
